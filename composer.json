{
    "name": "drupal/atelier",
    "description": "Atelier — an AI-first, chat-driven site builder built on Drupal. North star: 1M Drupal installs.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "AIncient Labs",
            "homepage": "https://aincient-labs.com",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://aincient-labs.com",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^1.7.3",
        "drupal/admin_theme": "^1.1",
        "drupal/coffee": "^2.0.1",
        "drupal/config_ignore": "^3.4",
        "drupal/config_split": "^2.0.2",
        "drupal/core": "^11.4.4",
        "drupal/core-composer-scaffold": "^11.4.4",
        "drupal/core-project-message": "^11.4.4",
        "drupal/core-recipe-unpack": "^11.4.4",
        "drupal/crop": "^2.6",
        "drupal/csv_serialization": "^4.0",
        "drupal/file_mdm": "^3.2",
        "drupal/flowdrop": "^2",
        "drupal/focal_point": "^2.1",
        "drupal/image_style_quality": "^1.7",
        "drupal/image_widget_crop": "^3.0",
        "drupal/imagemagick": "^5.0.1",
        "drupal/key": "^1.22",
        "drupal/metatag": "^2.2",
        "drupal/pathauto": "^1.15",
        "drupal/rabbit_hole": "^1.2",
        "drupal/redirect": "^1.13",
        "drupal/revision_graph": "^3.1.1",
        "drupal/rift": "^2.0.0-rc1",
        "drupal/schema_metatag": "^3.0.4",
        "drupal/simple_sitemap": "^4.2.3",
        "drupal/sophron": "^3.1",
        "drupal/token": "^1.17",
        "drupal/tome": "^1.16",
        "drupal/views_data_export": "^1.10",
        "drush/drush": "^13.7.6",
        "league/commonmark": "^2.8.3",
        "symfony/ai-anthropic-platform": "^0.12",
        "symfony/ai-deep-seek-platform": "^0.12",
        "symfony/ai-gemini-platform": "^0.12",
        "symfony/ai-generic-platform": "^0.12",
        "symfony/ai-mistral-platform": "^0.12",
        "symfony/ai-ollama-platform": "^0.12",
        "symfony/ai-open-ai-platform": "^0.12",
        "symfony/ai-platform": "^0.12"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "SIMPLETEST_DB=sqlite://localhost//tmp/phpunit.sqlite BROWSERTEST_OUTPUT_DIRECTORY=/tmp phpunit -c web/core/phpunit.xml.dist web/modules/custom",
        "_comment_prune-engine-tier": [
            "flowdrop installs to web/modules/engine (see installer-paths) so the appliance image can",
            "cache that fast-moving tier as its own layer. When that mapping changed, composer installed",
            "to the new path but left the directory already sitting at the old one — it keeps no record of",
            "a path it used to own — so any tree that predates the move has flowdrop in BOTH tiers, which",
            "Drupal reads as two modules with the same name. This heals that automatically.",
            "",
            "The `[ -f ... ]` test and trailing `true` are load-bearing: docker/Dockerfile's vendor stage",
            "runs `composer install` WITHOUT --no-scripts and with only composer.json, composer.lock and",
            "patches/ in the build context, so the script file is absent there. Without the guard the",
            "hook would fail and take the whole image build with it.",
            "",
            "--heal only deletes a contrib copy that is duplicated in engine/. A flowdrop package present",
            "ONLY in contrib is a live module missing from the installer-paths list, so it is left alone",
            "and CI fails on it instead."
        ],
        "prune-engine-tier": "sh -c '[ -f docker/tests/assert-engine-tier.sh ] && bash docker/tests/assert-engine-tier.sh --heal; true'",
        "post-install-cmd": [
            "@prune-engine-tier"
        ],
        "post-update-cmd": [
            "@prune-engine-tier"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "sort-packages": true,
        "audit": {
            "abandoned": "report"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "_removed-with-drupal-ai": "The two-release uninstall window closed here. drupal/ai, ai_agents, ai_metering, gemini_provider, flowdrop_ai_provider and the seven ai_provider_* packages were UNINSTALLED in the release that shipped as v0.1.0 (config/sync stopped listing them, so converge's config:import uninstalls them) and are now dropped from require, along with the three patches that only ever patched their code. The window existed because drush pm:uninstall needs a module's own hook_uninstall and schema to drop its tables cleanly — dropping the package first would delete the code before the uninstall could use it. Any site on v0.1.0 or newer has already been through that uninstall and upgrades here directly. A site that never did (a pre-v0.1.0 :edge build) still has them installed, and cannot boot without their code at all — which is why docker/converge.sh refuses that upgrade outright, naming the modules, before touching the database. See .dev DECISIONS 0295 (the uninstalls) and 0320 (this removal).",
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/admin_theme": {
                "PHP 8.4: use explicit nullable type on isAdminRoute() param": "patches/admin-theme-nullable-route.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/engine/{$name}": [
                "drupal/flowdrop"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        }
    },
    "require-dev": {
        "drupal/core-dev": "^11.4.4"
    }
}
