{#
/**
 * @file
 * Branded, chrome-less auth screen — the product front door.
 *
 * Shared by every auth surface (login / password reset / register): the theme
 * routes all three routes to this template via a page suggestion (see
 * aincient_theme_theme_suggestions_page_alter()), so they look identical.
 *
 * LAYOUT (DECISIONS 0422 — "direction C1"): a centred split CARD on the site's
 * muted ground — an ink identity panel beside the form from 1024px up. Below
 * that the panel is DROPPED, not stacked, and the card narrows to the form
 * alone, so the submit button never gets pushed down the page (a stacked panel
 * put it under the fixed consent banner on short phones).
 *
 * The panel wears the SITE's own ink + primary, never Atelier's brand — a
 * user's site never inherits ours. The only thing of ours on the screen is the
 * optional "Build with Atelier" line in the panel foot.
 *
 * ORDER: the form is FIRST in the DOM and placed to the right by grid `order`,
 * so a keyboard or screen-reader user lands on the username field instead of
 * tabbing through the identity panel. Never reorder these two in source.
 *
 * Brand vars + the per-route heading/link come from
 * aincient_theme_preprocess_page(); the form itself is styled in build/input.css.
 #}
<div class="ain-auth-screen">
  <div class="ain-auth-card">

  <main id="main-content" tabindex="-1" class="ain-auth-main">
    <div class="ain-auth-inner">

      {# The panel is hidden below 1024px, so the site names itself here instead. #}
      <div class="ain-auth-id">
        {% if ain_auth.logo_url %}
          <img src="{{ ain_auth.logo_url }}" alt="{{ ain_auth.name }}" class="ain-auth-id__logo" />
        {% else %}
          <span class="ain-auth-id__name">{{ ain_auth.name }}</span>
        {% endif %}
      </div>

      <h1 class="ain-auth-heading">{{ ain_auth.heading }}</h1>

      {{ ain_auth.messages }}

      {{ page.content }}

      {% if ain_auth.alt.url %}
        <p class="ain-auth-alt">
          <a href="{{ ain_auth.alt.url }}">{{ ain_auth.alt.label }}</a>
        </p>
      {% endif %}

    </div>
  </main>

  <aside class="ain-auth-panel">
    <div class="ain-auth-panel__id">
      {% if ain_auth.logo_url %}
        <img src="{{ ain_auth.logo_url }}" alt="{{ ain_auth.name }}" class="ain-auth-panel__logo" />
      {% else %}
        <p class="ain-auth-panel__name">{{ ain_auth.name }}</p>
      {% endif %}
      {% if ain_auth.tagline %}
        <p class="ain-auth-panel__tagline">{{ ain_auth.tagline }}</p>
      {% endif %}
    </div>
    {% if ain_auth.build_with %}
      <p class="ain-auth-panel__foot">{{ 'Build with Atelier'|t }}</p>
    {% endif %}
  </aside>

  </div>
</div>
