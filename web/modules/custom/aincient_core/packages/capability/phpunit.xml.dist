<?xml version="1.0" encoding="UTF-8"?>
<!-- Standalone run for the split mirror (composer install && vendor/bin/phpunit).
     In the cms repo the root phpunit.xml `packages` testsuite runs these instead. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="aincient-capability">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>src</directory>
    </include>
  </source>
</phpunit>
