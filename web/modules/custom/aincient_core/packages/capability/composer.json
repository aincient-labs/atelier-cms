    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "AIncient Labs",
            "homepage": "https://aincient-labs.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
