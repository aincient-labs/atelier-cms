{
    "name": "aincient/inference",
    "description": "Atelier inference on symfony/ai: the provider adapters and registry, the one-shot gateway, the plain chat completer, the result unpacker, tool schema and tool-call recovery, retries with named provider failures, and the model-role set. No Drupal dependency.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "AIncient Labs",
            "homepage": "https://aincient-labs.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "symfony/ai-anthropic-platform": "^0.12",
        "symfony/ai-gemini-platform": "^0.12",
        "symfony/ai-generic-platform": "^0.12",
        "symfony/ai-mistral-platform": "^0.12",
        "symfony/ai-ollama-platform": "^0.12",
        "symfony/ai-open-ai-platform": "^0.12",
        "symfony/ai-platform": "^0.12",
        "symfony/event-dispatcher-contracts": "^3.8",
        "symfony/http-client-contracts": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/http-client": "^7.3 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Aincient\\Inference\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aincient\\Inference\\Tests\\": "tests/"
        }
    }
}
