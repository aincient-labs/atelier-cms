{# The fixture pack section — token-routed styling only (the pack contract). #}
<section class="spotlight spotlight--{{ variant|default('left') }}" data-tone="{{ tone|default('default') }}">
  <div class="spotlight__copy">
    {% if eyebrow %}<p class="spotlight__eyebrow">{{ eyebrow }}</p>{% endif %}
    {% if heading %}<h2 class="spotlight__heading">{{ heading }}</h2>{% endif %}
    {% if claim %}<p class="spotlight__claim">{{ claim }}</p>{% endif %}
    {% if cta_label and cta_url %}<a class="spotlight__cta" href="{{ cta_url }}">{{ cta_label }}</a>{% endif %}
  </div>
  {% if image %}<div class="spotlight__media"><img src="{{ image }}" alt="" /></div>{% endif %}
</section>
