{
    "name": "aincient/page-model",
    "description": "Atelier page model: the page-schema codec and linter, the component catalog compiler and admission gate, and the design-token registry, resolver, contrast checks and grounding. No Drupal dependency.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "AIncient Labs",
            "homepage": "https://aincient-labs.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "league/commonmark": "^2.10",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Aincient\\PageModel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aincient\\PageModel\\Tests\\": "tests/"
        }
    }
}
